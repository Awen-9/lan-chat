{
  "name": "lan-chat",
  "version": "1.0.0",
  "description": "局域网聊天室 + 文件互传（Electron 桌面应用，Windows / macOS / Linux 通用）",
  "main": "main.js",
  "author": "Awen-9",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "server": "node server.js",
    "check:privacy": "node scripts/privacy-check.cjs --all",
    "review:staged": "node scripts/privacy-check.cjs --staged --review",
    "check:privacy:staged": "node scripts/privacy-check.cjs --staged",
    "test:privacy": "node --test scripts/privacy-check.test.cjs",
    "test": "node --test test/server.test.js scripts/privacy-check.test.cjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.awen9.lanchat",
    "productName": "局域网聊天室",
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "main.js",
      "server.js",
      "public/**/*",
      "build/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "lan-chat-setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "lan-chat-portable-${version}-${arch}.${ext}"
    },
    "mac": {
      "artifactName": "lan-chat-mac-${version}-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking",
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "identity": null,
      "extendInfo": {
        "LSMinimumSystemVersion": "10.15"
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Network"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
